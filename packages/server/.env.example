PORT=3001
# Supabase: use the pooler connection string from Project Settings > Database
# Transaction pooler (port 6543) recommended for this workload.
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Set to true if your Postgres requires SSL (Supabase recommends it)
DB_SSL=true
STORAGE_DIR=./storage
